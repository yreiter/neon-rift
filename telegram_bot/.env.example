# Required
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — OpenAI key enables /gpt command (ChatGPT GPT-4o)
OPENAI_API_KEY=

# Optional — Telegram userbot (MTProto) for accessing your personal groups.
# Get api_id and api_hash from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+972501234567
TELEGRAM_2FA_PASSWORD=

# Optional — comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=

# Optional — number of past messages to keep in context (default: 40)
MAX_HISTORY_MESSAGES=40

# Optional — custom system prompt for the assistant
SYSTEM_PROMPT=You are a helpful, friendly AI assistant. Answer clearly and concisely. When the user writes in Hebrew, respond in Hebrew.
